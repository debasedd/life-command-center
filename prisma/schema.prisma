generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum BlockType {
  SCHOOL
  LESSON
  ACTIVITY
  PERSONAL
}

enum TxType {
  INCOME
  EXPENSE
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
}

enum Intensity {
  RINGAN
  SEDANG
  BERAT
}

enum NotifType {
  TASK_DEADLINE
  WORKOUT_REMINDER
  WATER_REMINDER
  DAILY_RECAP
  WEEKLY_EVAL
  MISSED_DEADLINE
  MILESTONE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model Task {
  id               String   @id @default(uuid())
  userId           String
  title            String
  description      String?
  subject          String?
  priority         Priority @default(MEDIUM)
  status           TaskStatus @default(TODO)
  deadline         DateTime?
  estimatedMinutes Int?
  recurring        Boolean  @default(false)
  photoData        String? // base64 (no prefix) — foto soal tugas
  photoMime        String? // image/jpeg | image/png | image/heic
  aiAnswer         String? // pembahasan lengkap dari AI (markdown)
  aiAnswerAt       DateTime? // kapan AI selesai mengerjakan
  aiStatus         String   @default("NONE") // NONE | PENDING | DONE | FAILED
  aiError          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, deadline])
}

model ScheduleBlock {
  id          String    @id @default(uuid())
  userId      String
  title       String
  type        BlockType @default(SCHOOL)
  startMinute Int // minutes since midnight
  endMinute   Int
  weekday     Int? // 0=Sun .. 6=Sat, null = one-off
  date        String? // yyyy-mm-dd for one-off events
  location    String?
  createdAt   DateTime  @default(now())

  @@index([userId, weekday])
  @@index([userId, date])
}

model Category {
  id           String        @id @default(uuid())
  userId       String
  name         String
  icon         String        @default("📦")
  color        String        @default("#71717a")
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id            String   @id @default(uuid())
  userId        String
  type          TxType
  amount        Int
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  note          String?
  day           String // yyyy-mm-dd (WIB)
  aiCategorized Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, day])
  @@index([userId, categoryId])
}

model SavingsGoal {
  id                String     @id @default(uuid())
  userId            String
  name              String
  targetAmount      Int
  currentAmount     Int        @default(0)
  deadline          String?
  monthlyCommitment Int?
  status            GoalStatus @default(ACTIVE)
  icon              String     @default("🎯")
  createdAt         DateTime   @default(now())

  @@index([userId, status])
}

model GoalDeposit {
  id        String   @id @default(uuid())
  userId    String
  goalId    String
  amount    Int
  day       String
  createdAt DateTime @default(now())

  @@index([userId, goalId])
}

model InvestmentProfile {
  userId            String   @id
  monthlyInvestment Int      @default(0)
  assets            Json     @default("[]")
  years             Int      @default(10)
  updatedAt         DateTime @updatedAt
}

model Workout {
  id              String    @id @default(uuid())
  userId          String
  type            String
  durationMinutes Int
  intensity       Intensity @default(SEDANG)
  day             String
  notes           String?
  createdAt       DateTime  @default(now())

  @@index([userId, day])
}

model WaterLog {
  id        String   @id @default(uuid())
  userId    String
  day       String
  amountMl  Int
  createdAt DateTime @default(now())

  @@index([userId, day])
}

model SleepLog {
  id          String   @id @default(uuid())
  userId      String
  day         String
  bedMinute   Int // minutes since midnight
  wakeMinute  Int
  quality     Int?
  createdAt   DateTime @default(now())

  @@unique([userId, day])
}

model Habit {
  id            String   @id @default(uuid())
  userId        String
  name          String
  icon          String   @default("✅")
  targetPerWeek Int      @default(7)
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, archived])
}

model HabitCheckin {
  id        String   @id @default(uuid())
  userId    String
  habitId   String
  day       String
  createdAt DateTime @default(now())

  @@unique([habitId, day])
  @@index([userId, day])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model NotificationPref {
  id          String    @id @default(uuid())
  userId      String
  type        NotifType
  enabled     Boolean   @default(true)
  minuteOfDay Int       @default(540)

  @@unique([userId, type])
}

model ScheduledNotification {
  id        String    @id @default(uuid())
  userId    String
  type      NotifType
  sendAt    DateTime
  title     String
  body      String
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([sendAt, sentAt])
  @@index([userId])
}

model Evaluation {
  id          String   @id @default(uuid())
  userId      String
  healthScore Int
  result      Json
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model Settings {
  userId            String   @id
  waterTargetMl     Int      @default(2000)
  glassMl           Int      @default(250)
  workoutPerWeek    Int      @default(3)
  quietStartMinute  Int      @default(1320) // 22:00
  quietEndMinute    Int      @default(360) // 06:00
  aiModel           String?  // pilihan model AI user (kebab id dari provider)
  updatedAt         DateTime @updatedAt
}

model AiCorrection {
  id         String   @id @default(uuid())
  userId     String
  note       String
  categoryId String
  createdAt  DateTime @default(now())

  @@index([userId])
}